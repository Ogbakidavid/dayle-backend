generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  name                    String
  role                    UserRole                 @default(NONE)
  status                  UserStatus               @default(ACTIVE)
  kycStatus               KycStatus                @default(NONE)
  profileImage            String?
  emailVerified           Boolean                  @default(false)
  twoFaEnabled            Boolean                  @default(false)
  twoFactorSecret         String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  disputes                Dispute[]
  evidenceCreated         Evidence[]
  invitesSent             Invite[]                 @relation("InvitesSent")
  kycData                 KycData?
  ledgerEntries           LedgerEntry[]
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  refundRequests          RefundRequest[]
  sessions                Session[]
  clientVaults            Vault[]                  @relation("ClientVaults")
  freelancerVaults        Vault[]                  @relation("FreelancerVaults")
  wallet                  Wallet?

  @@index([email])
  @@index([role])
  @@index([kycStatus])
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  permissions  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String   @unique
  privyDid  String   @unique
  provider  String   @default("PRIVY")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycData {
  id                String    @id @default(uuid())
  userId            String    @unique
  fullName          String
  dateOfBirth       DateTime
  address           String
  idDocumentUrl     String
  proofOfAddressUrl String?
  submittedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  rejectionReason   String?
  idNumber          String?
  idType            String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  accessToken  String   @unique
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
}

model Vault {
  id            String         @id @default(uuid())
  title         String
  description   String?
  status        VaultStatus    @default(DRAFT)
  totalAmount   BigInt
  clientId      String
  freelancerId  String?
  isFrozen      Boolean        @default(false)
  frozenReason  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  amount        BigInt         @default(0)
  chainId       Int
  tokenAddress  String
  tokenDecimals Int
  tokenSymbol   String?
  vaultAddress  String?        @unique
  type          VaultType      @default(FIXED_PRICE)
  deliverables  Deliverable[]
  disputes      Dispute[]
  invites       Invite[]
  ledgerEntries LedgerEntry[]
  refundRequest RefundRequest?
  submissions   Submission[]
  client        User           @relation("ClientVaults", fields: [clientId], references: [id])
  freelancer    User?          @relation("FreelancerVaults", fields: [freelancerId], references: [id])

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@index([createdAt])
}

model Deliverable {
  id             String         @id @default(uuid())
  vaultId        String
  title          String
  description    String?
  submissionType SubmissionType @default(FILE)
  vault          Vault          @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  submissions    Submission[]   @relation("SubmissionDeliverables")

  @@index([vaultId])
}

model Submission {
  id                String        @id @default(uuid())
  submittedAt       DateTime      @default(now())
  submittedBy       String
  notes             String?
  filesJson         Json?
  deliverableType   String?
  url               String?
  fileUrl           String?
  fileHash          String?
  fileSize          Int?
  fileMime          String?
  deliverableStatus Json?
  vaultId           String
  vault             Vault         @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  deliverables      Deliverable[] @relation("SubmissionDeliverables")

  @@index([vaultId])
}

model Dispute {
  id               String         @id @default(uuid())
  vaultId          String
  disputeType      DisputeType
  reasonCode       String
  openedByUserId   String
  openedByRole     UserRole
  status           DisputeStatus  @default(OPEN)
  description      String
  resolution       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resolvedAt       DateTime?
  deliverableId    String?
  deliverableTitle String?
  openedBy         User           @relation(fields: [openedByUserId], references: [id])
  vault            Vault          @relation(fields: [vaultId], references: [id])
  events           DisputeEvent[]
  evidence         Evidence[]

  @@index([vaultId])
  @@index([status])
  @@index([openedByUserId])
}

model DisputeEvent {
  id        String   @id @default(uuid())
  disputeId String
  actorId   String?
  actorRole String?
  eventType String
  payload   Json?
  createdAt DateTime @default(now())
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([createdAt])
}

model Evidence {
  id                       String       @id @default(uuid())
  vaultId                  String
  disputeId                String?
  type                     EvidenceType
  payload                  Json
  createdBy                String
  immutableAfterSubmission Boolean      @default(true)
  createdAt                DateTime     @default(now())
  creator                  User         @relation(fields: [createdBy], references: [id])
  dispute                  Dispute?     @relation(fields: [disputeId], references: [id])

  @@index([vaultId])
  @@index([disputeId])
  @@index([type])
}

model LedgerEntry {
  id          String            @id @default(uuid())
  userId      String
  vaultId     String?
  type        LedgerEntryType
  amount      BigInt
  currency    String            @default("USD")
  status      TransactionStatus @default(PENDING)
  description String
  providerRef String?
  disputeId   String?
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  user        User              @relation(fields: [userId], references: [id])
  vault       Vault?            @relation(fields: [vaultId], references: [id])

  @@index([userId])
  @@index([vaultId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Invite {
  id            String       @id @default(uuid())
  token         String       @unique
  vaultId       String
  email         String
  status        InviteStatus @default(PENDING)
  invitedBy     String
  invitedAt     DateTime     @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  declineReason String?
  inviter       User         @relation("InvitesSent", fields: [invitedBy], references: [id])
  vault         Vault        @relation(fields: [vaultId], references: [id])

  @@index([token])
  @@index([vaultId])
  @@index([email])
  @@index([status])
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  userId       String
  endpoint     String
  requestHash  String
  responseBody Json
  statusCode   Int
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([key])
  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  timestamp DateTime @default(now())
  read      Boolean  @default(false)
  action    String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([timestamp])
}

model NotificationPreferences {
  id                    String   @id @default(uuid())
  userId                String   @unique
  emailEnabled          Boolean  @default(true)
  telegramConnected     Boolean  @default(false)
  telegramUsername      String?
  telegramChatId        String?
  whatsappPhoneVerified Boolean  @default(false)
  whatsappPhoneE164     String?
  whatsappConfirmCode   String?
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefundRequest {
  id            String              @id @default(uuid())
  vaultId       String              @unique
  clientId      String
  amount        BigInt
  payoutMethod  String
  payoutDetails Json
  status        RefundRequestStatus @default(PENDING)
  adminNotes    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  client        User                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vault         Vault               @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
}

enum VaultStatus {
  DRAFT
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
  CANCELLED
}

enum VaultType {
  FIXED_PRICE
  DEVELOPMENT
  DESIGN
  CONTENT_AI
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  NEEDS_INFO
  RESOLVED
  REJECTED
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum UserRole {
  NONE
  CLIENT
  FREELANCER
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum LedgerEntryType {
  DEPOSIT
  LOCK
  RELEASE
  REFUND
  WITHDRAW
  FEE
}

enum DisputeType {
  VERIFICATION_ERROR
  REQUIREMENT_MISMATCH
  SCOPE_CHANGE
  BAD_FAITH
  FRAUD
  PROCESS_BREACH
  SECURITY
}

enum EvidenceType {
  MESSAGE
  MESSAGE_SENT
  REQUIREMENT_ITEM
  SUBMISSION_DELTA
  REVIEW_DECISION
  DISPUTE_EVENT
}

enum RefundRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum SubmissionType {
  FILE
  LINK
  BOTH
}
